{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id", "subject", "education_stage", "grade_scope", "curriculum_scopes",
    "canonical_knowledge_ids", "questions"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 4},
    "subject": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "education_stage": {"enum": ["primary", "junior_high", "senior_high"]},
    "grade_scope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 12}
    },
    "curriculum_scopes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "canonical_knowledge_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "knowledge_point_ids", "curriculum_scopes", "education_stage",
          "grade_scope", "question_type", "stem", "explanation", "difficulty",
          "cognitive_level", "reasoning_steps", "estimated_time_seconds",
          "tags", "source_type", "review_status", "authoring_method", "version"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 4},
          "knowledge_point_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 3}
          },
          "curriculum_scopes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "education_stage": {"enum": ["primary", "junior_high", "senior_high"]},
          "grade_scope": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 12}
          },
          "question_type": {
            "enum": [
              "single_choice", "multiple_choice", "true_false", "numeric",
              "fill_blank", "short_answer", "proof", "material_analysis", "essay"
            ]
          },
          "stem": {"type": "string", "minLength": 8},
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "correct_option_id": {"type": "string", "minLength": 1},
          "accepted_answers": {
            "type": "array", "minItems": 1,
            "items": {"type": ["string", "number", "boolean"]}
          },
          "rubric": {"type": "string", "minLength": 2},
          "explanation": {"type": "string", "minLength": 10},
          "difficulty": {"enum": ["basic", "medium", "advanced"]},
          "cognitive_level": {"enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]},
          "reasoning_steps": {"type": "integer", "minimum": 1, "maximum": 10},
          "estimated_time_seconds": {"type": "integer", "minimum": 15, "maximum": 7200},
          "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_type": {"enum": ["original", "licensed"]},
          "review_status": {"enum": ["draft", "self_checked", "subject_reviewed", "published", "retired"]},
          "authoring_method": {"enum": ["human", "human_ai_assisted", "ai_draft"]},
          "version": {"type": "integer", "minimum": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"question_type": {"const": "single_choice"}}},
            "then": {"required": ["options", "correct_option_id"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
