{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version", "data_version", "generated_at", "knowledge_domains",
    "question_banks", "curricula"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "data_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date"},
    "knowledge_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject", "education_stage", "knowledge_glob"],
        "properties": {
          "subject": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "education_stage": {"enum": ["primary", "junior_high", "senior_high"]},
          "knowledge_glob": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "question_banks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "subject", "education_stage", "question_glob"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "education_stage": {"enum": ["primary", "junior_high", "senior_high"]},
          "question_glob": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "curricula": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "subject", "label", "publisher", "catalog",
          "knowledge_mapping_glob"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "catalog": {"type": "string", "minLength": 1},
          "knowledge_mapping_glob": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
