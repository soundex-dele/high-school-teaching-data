{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "subject", "curriculum_id", "name", "summary", "objectives", "prerequisites", "common_mistakes", "keywords", "competency_tags", "reference", "questions"],
  "properties": {
    "id": {"type": "string", "pattern": "^(math\\.xj|history\\.pep)\\."},
    "subject": {"enum": ["math", "history"]},
    "curriculum_id": {"enum": ["xj-math-current", "pep-history-current"]},
    "name": {"type": "string", "minLength": 2},
    "summary": {"type": "string", "minLength": 20},
    "objectives": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 2}},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "common_mistakes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "keywords": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "competency_tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "review_status": {"enum": ["self_checked", "teacher_reviewed"]},
    "reference": {
      "type": "object",
      "required": ["publisher", "edition_scope", "chapter"],
      "properties": {
        "publisher": {"type": "string", "minLength": 2},
        "edition_scope": {"type": "string", "minLength": 2},
        "chapter": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "stem", "options", "correct_option_id", "explanation", "difficulty", "tags", "source_type"],
        "properties": {
          "id": {"type": "string", "minLength": 4},
          "stem": {"type": "string", "minLength": 8},
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": {"enum": ["A", "B", "C", "D"]},
                "text": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "correct_option_id": {"enum": ["A", "B", "C", "D"]},
          "explanation": {"type": "string", "minLength": 10},
          "difficulty": {"enum": ["basic", "medium", "advanced"]},
          "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_type": {"const": "original"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

