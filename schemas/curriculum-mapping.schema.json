{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id", "canonical_id", "curriculum_id", "subject", "education_stage",
    "grade_scope", "semester_scope", "display_name", "reference",
    "question_bank_ids", "review_status"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"},
    "canonical_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"},
    "curriculum_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "education_stage": {"enum": ["primary", "junior_high", "senior_high"]},
    "grade_scope": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 12}
    },
    "semester_scope": {"enum": ["first", "second", "both", "flexible"]},
    "display_name": {"type": "string", "minLength": 2},
    "reference": {
      "type": "object",
      "required": ["publisher", "edition_scope", "chapter"],
      "properties": {
        "publisher": {"type": "string", "minLength": 2},
        "edition_scope": {"type": "string", "minLength": 2},
        "chapter": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "question_bank_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 4}
    },
    "review_status": {"enum": ["self_checked", "teacher_reviewed"]}
  },
  "additionalProperties": false
}
